<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="adera_dashboard.ClinicDashboard">
        <div class="o_adera_dashboard d-flex flex-column h-100 w-100 overflow-auto bg-light">
            <!-- 1. EXECUTIVE HEADER BANNER -->
            <div class="o_adera_dash_header bg-white border-bottom px-4 py-3 shadow-sm">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="o_adera_dash_icon_box rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm">
                            <i class="fa fa-line-chart fs-3 text-white"/>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary text-white px-2 py-1">PT PROSPERRA MEDIKA UTAMA</span>
                                <span class="badge bg-purple text-white px-2 py-1">KLINIK ADERA</span>
                                <span class="badge bg-secondary text-white px-2 py-1">ERP V19</span>
                            </div>
                            <h3 class="fw-bold text-dark mb-0 mt-1">Executive Management Dashboard</h3>
                            <p class="text-muted small mb-0">
                                Dashboard Manajemen Eksekutif &amp; Analitika Finansial Operasional
                            </p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2 shadow-sm"
                                t-on-click="() => this.loadMetrics()"
                                t-att-disabled="state.isLoading">
                            <i t-attf-class="fa fa-refresh #{state.isLoading ? 'fa-spin' : ''}"/>
                            <span>Refresh Data</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 2. PARAMETER & FILTER TOOLBAR -->
            <div class="container-fluid px-4 py-3">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-3">
                        <div class="row g-3 align-items-center">
                            <!-- Preset Buttons -->
                            <div class="col-12 col-xl-5">
                                <span class="d-block text-muted small fw-semibold mb-1">Preset Periode:</span>
                                <div class="btn-group w-100" role="group">
                                    <button type="button"
                                            t-attf-class="btn btn-sm #{state.datePreset == 'this_month' ? 'btn-primary' : 'btn-outline-secondary'}"
                                            t-on-click="() => this.onDatePresetChange('this_month')">
                                        Bulan Ini
                                    </button>
                                    <button type="button"
                                            t-attf-class="btn btn-sm #{state.datePreset == 'last_30_days' ? 'btn-primary' : 'btn-outline-secondary'}"
                                            t-on-click="() => this.onDatePresetChange('last_30_days')">
                                        30 Hari Terakhir
                                    </button>
                                    <button type="button"
                                            t-attf-class="btn btn-sm #{state.datePreset == 'this_quarter' ? 'btn-primary' : 'btn-outline-secondary'}"
                                            t-on-click="() => this.onDatePresetChange('this_quarter')">
                                        Kuartal Ini
                                    </button>
                                    <button type="button"
                                            t-attf-class="btn btn-sm #{state.datePreset == 'ytd' ? 'btn-primary' : 'btn-outline-secondary'}"
                                            t-on-click="() => this.onDatePresetChange('ytd')">
                                        Tahun Ini (YTD)
                                    </button>
                                    <button type="button"
                                            t-attf-class="btn btn-sm #{state.datePreset == 'all_time' ? 'btn-primary' : 'btn-outline-secondary'}"
                                            t-on-click="() => this.onDatePresetChange('all_time')">
                                        Semua Data
                                    </button>
                                </div>
                            </div>

                            <!-- Custom Date Range -->
                            <div class="col-12 col-sm-6 col-xl-3">
                                <span class="d-block text-muted small fw-semibold mb-1">Rentang Tanggal Khusus:</span>
                                <div class="input-group input-group-sm">
                                    <input type="date" class="form-control" t-att-value="state.dateFrom"
                                           t-on-change="(ev) => this.onDateChange(ev, 'dateFrom')"/>
                                    <span class="input-group-text bg-light text-muted">s/d</span>
                                    <input type="date" class="form-control" t-att-value="state.dateTo"
                                           t-on-change="(ev) => this.onDateChange(ev, 'dateTo')"/>
                                </div>
                            </div>

                            <!-- Business Unit Filter -->
                            <div class="col-12 col-sm-6 col-xl-4">
                                <span class="d-block text-muted small fw-semibold mb-1">Unit Bisnis &amp; Pelayanan:</span>
                                <div class="btn-group w-100" role="group">
                                    <button type="button"
                                            t-attf-class="btn btn-sm #{state.businessUnit == 'all' ? 'btn-purple text-white' : 'btn-outline-purple'}"
                                            t-on-click="() => this.onBusinessUnitChange('all')">
                                        Semua Unit
                                    </button>
                                    <button type="button"
                                            t-attf-class="btn btn-sm #{state.businessUnit == 'ACC-PRATAMA' ? 'btn-purple text-white' : 'btn-outline-purple'}"
                                            t-on-click="() => this.onBusinessUnitChange('ACC-PRATAMA')">
                                        Klinik Pratama
                                    </button>
                                    <button type="button"
                                            t-attf-class="btn btn-sm #{state.businessUnit == 'ACC-HD' ? 'btn-purple text-white' : 'btn-outline-purple'}"
                                            t-on-click="() => this.onBusinessUnitChange('ACC-HD')">
                                        Klinik Utama HD
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- LOADING SPINNER PLACEHOLDER -->
                <t t-if="state.isLoading">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Memuat data...</span>
                        </div>
                        <p class="text-muted mt-2">Sedang menghitung metrik analitika klinik...</p>
                    </div>
                </t>

                <t t-elif="state.metrics">
                    <!-- 3. SECTION E: AUDIT & COMPLIANCE WARNING FLAGS RIBBON -->
                    <div class="row g-3 mb-4">
                        <!-- Flag 1: GR/IR Interim Clearing 211500 -->
                        <div class="col-12 col-md-4">
                            <div t-attf-class="card border-0 shadow-sm h-100 #{state.metrics.compliance_flags.grir_alert ? 'border-start border-danger border-4' : 'border-start border-success border-4'}">
                                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <span class="text-muted small d-block">GR/IR Clearing (211500)</span>
                                        <h5 class="fw-bold mb-0 font-monospace" t-attf-class="#{state.metrics.compliance_flags.grir_alert ? 'text-danger' : 'text-success'}">
                                            <t t-esc="formatCompactCurrency(state.metrics.compliance_flags.grir_clearing_balance)"/>
                                        </h5>
                                        <span class="small text-muted" t-if="!state.metrics.compliance_flags.grir_alert">
                                            <i class="fa fa-check-circle text-success me-1"/> 3-Way Match Lengkap &amp; Seimbang (Rp 0,00)
                                        </span>
                                        <span class="small text-danger fw-semibold" t-else="">
                                            <i class="fa fa-exclamation-triangle me-1"/> Selisih Penerimaan vs Tagihan Vendor
                                        </span>
                                    </div>
                                    <div t-attf-class="badge rounded-circle p-3 #{state.metrics.compliance_flags.grir_alert ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success'}">
                                        <i class="fa fa-truck fs-4"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Flag 2: Cashier Variance 619990 -->
                        <div class="col-12 col-md-4">
                            <div t-attf-class="card border-0 shadow-sm h-100 #{state.metrics.compliance_flags.cashier_alert ? 'border-start border-danger border-4' : 'border-start border-success border-4'}">
                                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <span class="text-muted small d-block">Selisih Kasir YTD (619990)</span>
                                        <h5 class="fw-bold mb-0 font-monospace" t-attf-class="#{state.metrics.compliance_flags.cashier_alert ? 'text-danger' : 'text-dark'}">
                                            <t t-esc="formatCompactCurrency(state.metrics.compliance_flags.cashier_variance_ytd)"/>
                                        </h5>
                                        <span class="small text-muted" t-if="!state.metrics.compliance_flags.cashier_alert">
                                            <i class="fa fa-check text-success me-1"/> Dalam Batas Toleransi Blind Count
                                        </span>
                                        <span class="small text-danger fw-semibold" t-else="">
                                            <i class="fa fa-warning me-1"/> Melebihi Batas Toleransi Rp 1.000.000
                                        </span>
                                    </div>
                                    <div t-attf-class="badge rounded-circle p-3 #{state.metrics.compliance_flags.cashier_alert ? 'bg-danger-subtle text-danger' : 'bg-primary-subtle text-primary'}">
                                        <i class="fa fa-money fs-4"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Flag 3: Near-Expiry Lots (< 60 Days) -->
                        <div class="col-12 col-md-4">
                            <div t-attf-class="card border-0 shadow-sm h-100 #{state.metrics.compliance_flags.near_expiry_alert ? 'border-start border-warning border-4' : 'border-start border-success border-4'}">
                                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <span class="text-muted small d-block">Batch Obat Kedaluwarsa (&lt; 60 Hari)</span>
                                        <h5 class="fw-bold mb-0 font-monospace" t-attf-class="#{state.metrics.compliance_flags.near_expiry_alert ? 'text-warning' : 'text-success'}">
                                            <t t-esc="state.metrics.compliance_flags.near_expiry_lots_count"/> Batch
                                        </h5>
                                        <span class="small text-muted" t-if="!state.metrics.compliance_flags.near_expiry_alert">
                                            <i class="fa fa-check text-success me-1"/> Seluruh Stok FEFO Aman
                                        </span>
                                        <span class="small text-warning fw-semibold" t-else="">
                                            <i class="fa fa-clock-o me-1"/> Perlu Prioritas Pengeluaran FEFO
                                        </span>
                                    </div>
                                    <div t-attf-class="badge rounded-circle p-3 #{state.metrics.compliance_flags.near_expiry_alert ? 'bg-warning-subtle text-warning' : 'bg-success-subtle text-success'}">
                                        <i class="fa fa-medkit fs-4"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. SECTION A: EXECUTIVE SCORECARD GRID -->
                    <div class="row g-3 mb-4">
                        <!-- Card 1: Revenue -->
                        <div class="col-12 col-sm-6 col-xl">
                            <div class="card border-0 shadow-sm h-100 o_stat_card">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="text-muted small fw-bold">TOTAL PENDAPATAN (REVENUE)</span>
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1">Akun 410xxx</span>
                                    </div>
                                    <h3 class="fw-bold text-dark mb-1 font-monospace">
                                        <t t-esc="formatCompactCurrency(state.metrics.scorecards.total_revenue)"/>
                                    </h3>
                                    <div class="d-flex align-items-center justify-content-between text-muted small">
                                        <span>Beban Pokok (COGS):</span>
                                        <span class="fw-semibold text-danger font-monospace">
                                            <t t-esc="formatCompactCurrency(state.metrics.scorecards.cogs)"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card 2: Net Profit -->
                        <div class="col-12 col-sm-6 col-xl">
                            <div class="card border-0 shadow-sm h-100 o_stat_card">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="text-muted small fw-bold">LABA BERSIH (NET PROFIT)</span>
                                        <span t-attf-class="badge bg-#{state.metrics.scorecards.net_margin_pct.rag} rounded-pill px-2 py-1">
                                            Margin: <t t-esc="state.metrics.scorecards.net_margin_pct.value"/>%
                                        </span>
                                    </div>
                                    <h3 t-attf-class="fw-bold mb-1 font-monospace #{state.metrics.scorecards.net_profit &gt;= 0 ? 'text-success' : 'text-danger'}">
                                        <t t-esc="formatCompactCurrency(state.metrics.scorecards.net_profit)"/>
                                    </h3>
                                    <div class="d-flex align-items-center justify-content-between text-muted small">
                                        <span>Jasa Medis Dokter:</span>
                                        <span class="fw-semibold font-monospace">
                                            <t t-esc="formatCompactCurrency(state.metrics.scorecards.doctor_fees)"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card 3: Gross Margin -->
                        <div class="col-12 col-sm-6 col-xl">
                            <div class="card border-0 shadow-sm h-100 o_stat_card">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="text-muted small fw-bold">GROSS PROFIT MARGIN</span>
                                        <span t-attf-class="badge bg-#{state.metrics.scorecards.gross_margin_pct.rag} rounded-pill px-2 py-1">
                                            Target &gt;= 55%
                                        </span>
                                    </div>
                                    <h3 t-attf-class="fw-bold mb-1 font-monospace text-#{state.metrics.scorecards.gross_margin_pct.rag}">
                                        <t t-esc="state.metrics.scorecards.gross_margin_pct.value"/>%
                                    </h3>
                                    <div class="d-flex align-items-center justify-content-between text-muted small">
                                        <span>Beban Operasional:</span>
                                        <span class="fw-semibold font-monospace">
                                            <t t-esc="formatCompactCurrency(state.metrics.scorecards.opex)"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card 4: Kemenkes 80% Operating Ratio Rule -->
                        <div class="col-12 col-sm-6 col-xl">
                            <div class="card border-0 shadow-sm h-100 o_stat_card">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="text-muted small fw-bold">OPERATING RATIO (KEMENKES)</span>
                                        <span t-attf-class="badge bg-#{state.metrics.scorecards.operating_ratio ? state.metrics.scorecards.operating_ratio.rag : 'secondary'} rounded-pill px-2 py-1">
                                            Batas &lt;= 80%
                                        </span>
                                    </div>
                                    <h3 t-attf-class="fw-bold mb-1 font-monospace text-#{state.metrics.scorecards.operating_ratio ? state.metrics.scorecards.operating_ratio.rag : 'dark'}">
                                        <t t-if="state.metrics.scorecards.operating_ratio">
                                            <t t-esc="state.metrics.scorecards.operating_ratio.value"/>%
                                        </t>
                                        <t t-else="">
                                            0.0%
                                        </t>
                                    </h3>
                                    <div class="d-flex align-items-center justify-content-between text-muted small">
                                        <span>Total Beban Operasi:</span>
                                        <span class="fw-semibold font-monospace">
                                            <t t-if="state.metrics.scorecards.operating_ratio">
                                                <t t-esc="formatCompactCurrency(state.metrics.scorecards.operating_ratio.total_operating_cost)"/>
                                            </t>
                                            <t t-else="">Rp 0</t>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card 5: SISTER KPI - Total Outstanding Receivables (AR) -->
                        <div class="col-12 col-sm-6 col-xl">
                            <div class="card border-0 shadow-sm h-100 o_stat_card">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="text-muted small fw-bold">TOTAL PIUTANG USAHA (AR)</span>
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2 py-1">1120xx</span>
                                    </div>
                                    <h3 class="fw-bold text-dark mb-1 font-monospace">
                                        <t t-esc="formatCompactCurrency(state.metrics.scorecards.total_ar)"/>
                                    </h3>
                                    <div class="text-muted small">
                                        <div class="d-flex justify-content-between">
                                            <span>BPJS (112020):</span>
                                            <span class="fw-semibold font-monospace"><t t-esc="formatCompactCurrency(state.metrics.scorecards.ar_breakdown.bpjs)"/></span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>Umum/Asuransi:</span>
                                            <span class="fw-semibold font-monospace">
                                                <t t-esc="formatCompactCurrency(state.metrics.scorecards.ar_breakdown.self_pay + state.metrics.scorecards.ar_breakdown.insurance)"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECONDARY RATIOS BAR (DSO, DPO, DIO, ARPT, ARPP, FINALISASI) -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card border-0 shadow-sm text-center p-2">
                                <span class="text-muted small d-block">DSO (Hari Piutang)</span>
                                <span class="fw-bold fs-6 font-monospace text-primary"><t t-esc="state.metrics.scorecards.dso_days"/> Hari</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card border-0 shadow-sm text-center p-2">
                                <span class="text-muted small d-block">DPO (Hari Hutang)</span>
                                <span class="fw-bold fs-6 font-monospace text-dark"><t t-esc="state.metrics.scorecards.dpo_days"/> Hari</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card border-0 shadow-sm text-center p-2">
                                <span class="text-muted small d-block">DIO (Hari Persediaan)</span>
                                <span class="fw-bold fs-6 font-monospace text-dark"><t t-esc="state.metrics.scorecards.inventory_days"/> Hari</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card border-0 shadow-sm text-center p-2">
                                <span class="text-muted small d-block">ARPT (Rev/Kunjungan)</span>
                                <span class="fw-bold fs-6 font-monospace text-purple"><t t-esc="formatCompactCurrency(state.metrics.scorecards.arpt)"/></span>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card border-0 shadow-sm text-center p-2">
                                <span class="text-muted small d-block">ARPP (Rev/Pasien)</span>
                                <span class="fw-bold fs-6 font-monospace text-success"><t t-esc="formatCompactCurrency(state.metrics.scorecards.arpp)"/></span>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card border-0 shadow-sm text-center p-2">
                                <span class="text-muted small d-block">Finalisasi Encounter</span>
                                <span t-attf-class="fw-bold fs-6 font-monospace text-#{state.metrics.scorecards.encounter_finalization_rate.rag}">
                                    <t t-esc="state.metrics.scorecards.encounter_finalization_rate.value"/>%
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- 5. HEALTHCARE OPERATIONAL WIDGETS (TOP SERVICES & TOP PHARMACY) -->
                    <div class="row g-3 mb-4">
                        <!-- Widget 1: Top 5 Clinical Services & Procedures -->
                        <div class="col-12 col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-user-md text-primary fs-5"/>
                                        <strong class="text-dark">Top 5 Layanan &amp; Prosedur Medis</strong>
                                    </div>
                                    <span class="badge bg-light text-muted border">Berdasarkan Nilai</span>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Nama Layanan Medis</th>
                                                    <th>Kategori</th>
                                                    <th class="text-end">Volume</th>
                                                    <th class="text-end">Total Nilai (Rp)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.metrics.top_clinical_services.length == 0">
                                                    <tr>
                                                        <td colspan="4" class="text-center py-3 text-muted">Belum ada layanan tercatat.</td>
                                                    </tr>
                                                </t>
                                                <t t-foreach="state.metrics.top_clinical_services" t-as="svc" t-key="svc.name">
                                                    <tr>
                                                        <td class="fw-semibold text-dark"><t t-esc="svc.name"/></td>
                                                        <td>
                                                            <span class="badge bg-primary-subtle text-primary">
                                                                <t t-esc="svc.type_label"/>
                                                            </span>
                                                        </td>
                                                        <td class="text-end font-monospace"><t t-esc="formatNumber(svc.qty)"/></td>
                                                        <td class="text-end font-monospace fw-bold text-primary">
                                                            <t t-esc="formatCompactCurrency(svc.revenue)"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Widget 2: Top 5 Dispensed Pharmacy & Consumables -->
                        <div class="col-12 col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-medkit text-purple fs-5"/>
                                        <strong class="text-dark">Top 5 Obat Farmasi &amp; Konsumabel</strong>
                                    </div>
                                    <span class="badge bg-light text-muted border">Pengeluaran FEFO</span>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Nama Obat / BHP Medis</th>
                                                    <th class="text-end">Kuantitas</th>
                                                    <th class="text-end">Total Nilai (Rp)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.metrics.top_pharmacy_items.length == 0">
                                                    <tr>
                                                        <td colspan="3" class="text-center py-3 text-muted">Belum ada data pengeluaran farmasi.</td>
                                                    </tr>
                                                </t>
                                                <t t-foreach="state.metrics.top_pharmacy_items" t-as="ph" t-key="ph.name">
                                                    <tr>
                                                        <td class="fw-semibold text-dark"><t t-esc="ph.name"/></td>
                                                        <td class="text-end font-monospace"><t t-esc="formatNumber(ph.qty)"/></td>
                                                        <td class="text-end font-monospace fw-bold text-danger">
                                                            <t t-esc="formatCompactCurrency(ph.total_value)"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 6. CHARTS ROW: FINANCIAL TREND & PAYER MIX -->
                    <div class="row g-3 mb-4">
                        <!-- Chart 1: 12-Month Financial Trend -->
                        <div class="col-12 col-xl-8">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-bar-chart text-purple fs-5"/>
                                        <strong class="text-dark">Tren Pendapatan Usaha vs Beban Pokok (12 Bulan)</strong>
                                    </div>
                                    <span class="badge bg-light text-muted border">Bar + Line Overlay</span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="o_chart_wrapper" style="height: 320px;">
                                        <canvas t-ref="revenueChartCanvas"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Chart 2: Payer Mix Donut -->
                        <div class="col-12 col-xl-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-pie-chart text-primary fs-5"/>
                                        <strong class="text-dark">Distribusi Payer Mix</strong>
                                    </div>
                                    <span class="badge bg-light text-muted border">Instrumen Bayar</span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="o_chart_wrapper" style="height: 240px;">
                                        <canvas t-ref="payerChartCanvas"/>
                                    </div>
                                    <div class="mt-3">
                                        <t t-foreach="state.metrics.payer_mix" t-as="p" t-key="p.key">
                                            <div class="d-flex align-items-center justify-content-between py-1 border-bottom small">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="rounded-circle d-inline-block" t-attf-style="width: 10px; height: 10px; background-color: #{p.color};"/>
                                                    <span class="text-dark"><t t-esc="p.label"/></span>
                                                </div>
                                                <div class="text-end">
                                                    <span class="fw-semibold text-dark font-monospace"><t t-esc="formatCompactCurrency(p.amount)"/></span>
                                                    <span class="text-muted ms-1">(<t t-esc="p.percentage"/>%)</span>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 7. SECONDARY ROW: ENCOUNTER VOLUME & PATIENT RETENTION -->
                    <div class="row g-3 mb-4">
                        <!-- Chart 3: Encounter Volume Stacked Bar -->
                        <div class="col-12 col-lg-8">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-stethoscope text-success fs-5"/>
                                        <strong class="text-dark">Kunjungan Selesai (Posted) vs Antrean Backlog</strong>
                                    </div>
                                    <span class="badge bg-light text-muted border">Stacked Volume</span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="o_chart_wrapper" style="height: 250px;">
                                        <canvas t-ref="encounterChartCanvas"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Patient Retention & Activity Card -->
                        <div class="col-12 col-lg-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-users text-purple fs-5"/>
                                        <strong class="text-dark">Aktivitas &amp; Retensi Pasien</strong>
                                    </div>
                                </div>
                                <div class="card-body p-3 d-flex flex-column justify-content-around">
                                    <div class="p-3 bg-light rounded text-center mb-2">
                                        <span class="text-muted small d-block">Tingkat Kunjungan Ulang (Revisit Rate)</span>
                                        <h2 class="fw-bold text-purple mb-0 font-monospace"><t t-esc="state.metrics.patient_activity.revisit_rate_pct"/>%</h2>
                                    </div>
                                    <div class="row g-2 text-center">
                                        <div class="col-6">
                                            <div class="p-2 border rounded">
                                                <span class="text-muted small d-block">Pasien Baru</span>
                                                <h5 class="fw-bold text-success mb-0 font-monospace">
                                                    <t t-esc="formatNumber(state.metrics.patient_activity.new_encounters)"/>
                                                </h5>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-2 border rounded">
                                                <span class="text-muted small d-block">Pasien Lama (Repeat)</span>
                                                <h5 class="fw-bold text-primary mb-0 font-monospace">
                                                    <t t-esc="formatNumber(state.metrics.patient_activity.returning_encounters)"/>
                                                </h5>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-muted small mt-2 text-center">
                                        <span>Total Kunjungan Periode: </span>
                                        <strong class="font-monospace"><t t-esc="formatNumber(state.metrics.patient_activity.total_encounters)"/></strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 8. SECTION B: CLINICAL VOLUME VS. FINANCIAL REVENUE CORRELATION MATRIX -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-table text-primary fs-5"/>
                                <strong class="text-dark">Matriks Profitabilitas Poliklinik &amp; Sub-Unit Layanan</strong>
                            </div>
                            <span class="text-muted small">Klik judul kolom untuk menyortir</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover table-striped align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="cursor-pointer" t-on-click="() => this.onSortTable('poli_code')">
                                            Kode Poli <i class="fa fa-sort ms-1 text-muted"/>
                                        </th>
                                        <th class="cursor-pointer" t-on-click="() => this.onSortTable('poli_name')">
                                            Nama Poli / Sub-Unit <i class="fa fa-sort ms-1 text-muted"/>
                                        </th>
                                        <th>Unit Bisnis</th>
                                        <th class="text-end cursor-pointer" t-on-click="() => this.onSortTable('encounter_count')">
                                            Kunjungan (MTD) <i class="fa fa-sort ms-1 text-muted"/>
                                        </th>
                                        <th class="text-end cursor-pointer" t-on-click="() => this.onSortTable('revenue')">
                                            Pendapatan (Rp) <i class="fa fa-sort ms-1 text-muted"/>
                                        </th>
                                        <th class="text-end cursor-pointer" t-on-click="() => this.onSortTable('arpt')">
                                            ARPT (Rev/Kunjungan) <i class="fa fa-sort ms-1 text-muted"/>
                                        </th>
                                        <th class="text-end cursor-pointer" t-on-click="() => this.onSortTable('cogs')">
                                            HPP Obat &amp; BHP <i class="fa fa-sort ms-1 text-muted"/>
                                        </th>
                                        <th class="text-end cursor-pointer" t-on-click="() => this.onSortTable('gross_profit')">
                                            Laba Kotor (Rp) <i class="fa fa-sort ms-1 text-muted"/>
                                        </th>
                                        <th class="text-end cursor-pointer" t-on-click="() => this.onSortTable('margin_pct')">
                                            Margin (%) <i class="fa fa-sort ms-1 text-muted"/>
                                        </th>
                                        <th class="text-center">Status RAG</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="sortedPoliMatrix.length == 0">
                                        <tr>
                                            <td colspan="10" class="text-center py-4 text-muted">
                                                Tidak ada transaksi akun analitik pada periode terpilih.
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="sortedPoliMatrix" t-as="row" t-key="row.poli_code">
                                        <tr>
                                            <td class="font-monospace fw-semibold text-primary"><t t-esc="row.poli_code"/></td>
                                            <td class="fw-semibold text-dark"><t t-esc="row.poli_name"/></td>
                                            <td>
                                                <span t-attf-class="badge #{row.unit_type == 'Pratama' ? 'bg-primary-subtle text-primary' : 'bg-purple-subtle text-purple'}">
                                                    <t t-esc="row.unit_type"/>
                                                </span>
                                            </td>
                                            <td class="text-end font-monospace fw-semibold"><t t-esc="formatNumber(row.encounter_count)"/></td>
                                            <td class="text-end font-monospace"><t t-esc="formatCompactCurrency(row.revenue)"/></td>
                                            <td class="text-end font-monospace text-purple"><t t-esc="formatCompactCurrency(row.arpt)"/></td>
                                            <td class="text-end font-monospace text-danger"><t t-esc="formatCompactCurrency(row.cogs)"/></td>
                                            <td class="text-end font-monospace fw-bold" t-attf-class="#{row.gross_profit &gt;= 0 ? 'text-success' : 'text-danger'}">
                                                <t t-esc="formatCompactCurrency(row.gross_profit)"/>
                                            </td>
                                            <td class="text-end font-monospace fw-bold">
                                                <t t-esc="row.margin_pct"/>%
                                            </td>
                                            <td class="text-center">
                                                <span t-attf-class="badge bg-#{row.rag_badge} text-white px-2 py-1">
                                                    <t t-if="row.rag_badge == 'success'">Optimal (&gt;= 40%)</t>
                                                    <t t-elif="row.rag_badge == 'warning'">Cukup (15-39%)</t>
                                                    <t t-else="">Perhatian (&lt; 15%)</t>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- FOOTER METADATA -->
                    <div class="text-center py-3 text-muted small">
                        <span>Decoupled Healthcare ERP • Odoo 19 Community Edition • PT Prosperra Medika Utama</span>
                    </div>
                </t>

                <!-- ERROR / RETRY FALLBACK -->
                <t t-else="">
                    <div class="alert alert-danger d-flex align-items-center gap-3 my-4 p-4 shadow-sm rounded-3" role="alert">
                        <i class="fa fa-exclamation-triangle fs-2 text-danger"/>
                        <div>
                            <h5 class="alert-heading fw-bold mb-1">Gagal Memuat Metrik Dashboard</h5>
                            <p class="mb-2 text-muted">Terjadi kendala saat mengambil data analitika eksekutif dari server.</p>
                            <button class="btn btn-danger btn-sm shadow-sm" t-on-click="() => this.loadMetrics()">
                                <i class="fa fa-refresh me-1"/> Coba Muat Ulang Data
                            </button>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
