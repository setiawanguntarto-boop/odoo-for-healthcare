<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================================================================
         1. CLINIC ASSET FORM VIEW
         =================================================================== -->
    <record id="view_clinic_asset_form" model="ir.ui.view">
        <field name="name">clinic.asset.form</field>
        <field name="model">clinic.asset</field>
        <field name="arch" type="xml">
            <form string="Aset Tetap &amp; Peralatan Medis">
                <header>
                    <button name="compute_depreciation_board"
                            string="Hitung Jadwal Penyusutan"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('draft', 'running')"/>
                    <button name="action_confirm"
                            string="Konfirmasi &amp; Operasikan Aset"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_set_to_draft"
                            string="Kembalikan ke Draf"
                            type="object"
                            class="btn-outline-warning"
                            invisible="state not in ('running', 'depreciated')"/>
                    <button name="action_dispose"
                            string="Afkir / Lepas Aset"
                            type="object"
                            class="btn-outline-danger"
                            invisible="state not in ('running', 'depreciated')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,depreciated"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-calculator" disabled="1">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="net_book_value" widget="monetary"/>
                                </span>
                                <span class="o_stat_text">Nilai Buku Bersih (NBV)</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-hourglass-half" disabled="1">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="remaining_months_count"/> / <field name="useful_life_months"/> Bln
                                </span>
                                <span class="o_stat_text">Sisa Masa Manfaat</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Nama Aset / Peralatan Medis"/>
                        <h1>
                            <field name="name" placeholder="Misal: Mesin Hemodialisis Nipro Surdial X - Unit 01" readonly="state != 'draft'"/>
                        </h1>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <field name="asset_code" placeholder="Kode / Tag Aset (e.g. AST-HD-001)" readonly="state != 'draft'"/>
                        </div>
                    </div>

                    <group>
                        <group string="Klasifikasi &amp; Legalitas Teknis">
                            <field name="asset_category" readonly="state != 'draft'"/>
                            <field name="analytic_distribution" widget="analytic_distribution" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Parameter Nilai Perolehan &amp; Amortisasi">
                            <field name="purchase_date" readonly="state != 'draft'"/>
                            <field name="purchase_value" widget="monetary" readonly="state != 'draft'"/>
                            <field name="salvage_value" widget="monetary" readonly="state != 'draft'"/>
                            <field name="useful_life_months" readonly="state != 'draft'"/>
                            <field name="depreciation_method" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group string="Integrasi Chart of Accounts (COA)">
                        <group>
                            <field name="asset_account_id" readonly="state != 'draft'"/>
                            <field name="depreciation_account_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="expense_account_id" readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group string="Ringkasan Amortisasi Berjalan">
                        <group>
                            <field name="monthly_depreciation" widget="monetary" readonly="1"/>
                            <field name="accumulated_depreciation" widget="monetary" readonly="1"/>
                        </group>
                        <group>
                            <field name="depreciated_months_count" readonly="1"/>
                            <field name="net_book_value" widget="monetary" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Jadwal Amortisasi Penyusutan (Depreciation Board)" name="depreciation_board">
                            <field name="depreciation_line_ids" readonly="1">
                                <list string="Tabel Penyusutan Bulanan" decoration-success="state == 'posted'" decoration-muted="state == 'draft'">
                                    <field name="sequence" string="Bulan Ke-"/>
                                    <field name="depreciation_date" string="Tanggal Amortisasi"/>
                                    <field name="amount" widget="monetary" string="Beban Periode"/>
                                    <field name="accumulated_amount" widget="monetary" string="Akumulasi Penyusutan"/>
                                    <field name="remaining_value" widget="monetary" string="Nilai Buku Bersih"/>
                                    <field name="move_id" string="Entri Jurnal GL" widget="many2one"/>
                                    <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-muted="state == 'draft'"/>
                                    <button name="action_post_line"
                                            string="Posting Jurnal"
                                            type="object"
                                            icon="fa-check-circle"
                                            class="btn-link"
                                            invisible="state == 'posted'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================================
         2. CLINIC ASSET LIST / TREE VIEW
         =================================================================== -->
    <record id="view_clinic_asset_tree" model="ir.ui.view">
        <field name="name">clinic.asset.tree</field>
        <field name="model">clinic.asset</field>
        <field name="arch" type="xml">
            <list string="Daftar Aset Medis &amp; Fasilitas">
                <field name="asset_code"/>
                <field name="name"/>
                <field name="asset_category"/>
                <field name="purchase_date"/>
                <field name="purchase_value" widget="monetary" sum="Total Nilai Perolehan"/>
                <field name="monthly_depreciation" widget="monetary" sum="Total Beban Bulanan"/>
                <field name="accumulated_depreciation" widget="monetary" sum="Total Akumulasi Penyusutan"/>
                <field name="net_book_value" widget="monetary" sum="Total Nilai Buku Bersih"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'running'"
                       decoration-muted="state in ('depreciated', 'disposed')"/>
            </list>
        </field>
    </record>

    <!-- ===================================================================
         3. CLINIC ASSET SEARCH VIEW
         =================================================================== -->
    <record id="view_clinic_asset_search" model="ir.ui.view">
        <field name="name">clinic.asset.search</field>
        <field name="model">clinic.asset</field>
        <field name="arch" type="xml">
            <search string="Pencarian Aset Tetap">
                <field name="name" string="Nama Aset / Kode" filter_domain="['|', ('name', 'ilike', self), ('asset_code', 'ilike', self)]"/>
                <field name="asset_category"/>
                <field name="asset_account_id"/>
                <separator/>
                <filter string="Draf" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Berjalan (Aktif Menyusut)" name="filter_running" domain="[('state', '=', 'running')]"/>
                <filter string="Selesai Disusutkan" name="filter_depreciated" domain="[('state', '=', 'depreciated')]"/>
                <group>
                    <filter string="Kategori Aset" name="group_category" context="{'group_by': 'asset_category'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Akun Aset" name="group_account" context="{'group_by': 'asset_account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================================================================
         4. DEPRECIATION LINE LIST & SEARCH VIEW (Buku Penyusutan)
         =================================================================== -->
    <record id="view_clinic_asset_depreciation_line_tree" model="ir.ui.view">
        <field name="name">clinic.asset.depreciation.line.tree</field>
        <field name="model">clinic.asset.depreciation.line</field>
        <field name="arch" type="xml">
            <list string="Jadwal &amp; Buku Penyusutan Aset" create="false" edit="false">
                <field name="depreciation_date"/>
                <field name="asset_id"/>
                <field name="sequence" string="Bulan Ke-"/>
                <field name="amount" widget="monetary" sum="Total Beban Penyusutan"/>
                <field name="accumulated_amount" widget="monetary"/>
                <field name="remaining_value" widget="monetary"/>
                <field name="move_id" widget="many2one"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-muted="state == 'draft'"/>
                <button name="action_post_line"
                        string="Posting Jurnal"
                        type="object"
                        icon="fa-check-circle"
                        class="btn-primary btn-sm"
                        invisible="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_asset_depreciation_line_search" model="ir.ui.view">
        <field name="name">clinic.asset.depreciation.line.search</field>
        <field name="model">clinic.asset.depreciation.line</field>
        <field name="arch" type="xml">
            <search string="Pencarian Buku Penyusutan">
                <field name="asset_id"/>
                <field name="depreciation_date"/>
                <filter string="Belum Dibukukan" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Telah Dibukukan" name="filter_posted" domain="[('state', '=', 'posted')]"/>
                <group>
                    <filter string="Aset Tetap" name="group_asset" context="{'group_by': 'asset_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Bulan Amortisasi" name="group_date" context="{'group_by': 'depreciation_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================================================================
         5. ROLL-FORWARD SCHEDULE WIZARD FORM VIEW
         =================================================================== -->
    <record id="view_clinic_asset_rollforward_wizard_form" model="ir.ui.view">
        <field name="name">clinic.asset.rollforward.wizard.form</field>
        <field name="model">clinic.asset.rollforward.wizard</field>
        <field name="arch" type="xml">
            <form string="Cetak Daftar Rincian Aset Tetap &amp; Penyusutan">
                <sheet>
                    <div class="oe_title">
                        <h2>Daftar Rincian Aset Tetap &amp; Penyusutan</h2>
                        <p class="text-muted">
                            Laporan Roll-Forward Perolehan, Mutasi, dan Akumulasi Penyusutan Aset Tetap (Table 7 / Note 1.e Panacea Benchmark).
                        </p>
                    </div>
                    <group>
                        <group string="Cakupan Periode Laporan">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Filter Entitas &amp; Golongan">
                            <field name="asset_category"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf" string="Cetak Dokumen Resmi (PDF)" type="object" class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ===================================================================
         6. ACTIONS
         =================================================================== -->
    <record id="action_clinic_asset_view" model="ir.actions.act_window">
        <field name="name">Daftar Aset Medis &amp; Fasilitas</field>
        <field name="res_model">clinic.asset</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_asset_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tambahkan Aset Tetap / Peralatan Medis Klinik Baru
            </p>
            <p>
                Kelola perolehan, masa manfaat, dan amortisasi garis lurus untuk Mesin Hemodialisis, RO System, Dental Unit, dan fasilitas klinik lainnya.
            </p>
        </field>
    </record>

    <record id="action_clinic_asset_depreciation_board" model="ir.actions.act_window">
        <field name="name">Jadwal &amp; Buku Penyusutan</field>
        <field name="res_model">clinic.asset.depreciation.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_clinic_asset_depreciation_line_search"/>
    </record>

    <record id="action_clinic_asset_rollforward_wizard" model="ir.actions.act_window">
        <field name="name">Daftar Rincian Aset Tetap &amp; Penyusutan</field>
        <field name="res_model">clinic.asset.rollforward.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ===================================================================
         7. SCHEDULED ACTION (IR.CRON): AUTOMATED MONTHLY ASSET DEPRECIATION
         =================================================================== -->
    <record id="cron_post_monthly_asset_depreciation" model="ir.cron">
        <field name="name">Akuntansi: Posting Otomatis Penyusutan Aset Medis Bulanan</field>
        <field name="model_id" ref="model_clinic_asset"/>
        <field name="state">code</field>
        <field name="code">model.cron_post_monthly_asset_depreciation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
