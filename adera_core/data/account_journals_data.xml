            <field name="name">Kliring Klaim BPJS Kesehatan</field>
            <field name="code">JBPJS</field>
            <field name="type">general</field>
        </record>

        <!-- ===================================================================
             CLINICAL SALES JOURNALS
             =================================================================== -->
        <record id="journal_inv_out" model="account.journal">
            <field name="name">Penjualan Pelayanan Rawat Jalan</field>
            <field name="code">INVOUT</field>
            <field name="type">sale</field>
