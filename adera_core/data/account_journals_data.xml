        <record id="journal_inv_hd" model="account.journal">
            <field name="name">Penjualan Pelayanan Hemodialisis</field>
            <field name="code">INVHD</field>
            <field name="type">sale</field>
            <field name="default_account_id" ref="account_410110"/>
        </record>

        <!-- ===================================================================
             PURCHASE & OPERATIONAL JOURNALS
             =================================================================== -->
        <record id="journal_bill_med" model="account.journal">
            <field name="name">Faktur Pembelian Pemasok Medis</field>
            <field name="code">BMED</field>
            <field name="type">purchase</field>
            <field name="default_account_id" ref="account_510010"/>
