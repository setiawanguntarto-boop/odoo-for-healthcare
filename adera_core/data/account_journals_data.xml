            <field name="name">Kas Kasir Rawat Jalan</field>
            <field name="code">KKSR</field>
            <field name="type">cash</field>
            <field name="default_account_id" ref="account_111010"/>
        </record>

        <record id="journal_bank_bca" model="account.journal">
            <field name="name">Bank BCA Operasional</field>
            <field name="code">BBCA</field>
            <field name="type">bank</field>
            <field name="default_account_id" ref="account_111110"/>
        </record>

        <record id="journal_pg_midtrans" model="account.journal">
            <field name="name">Payment Gateway &amp; QRIS Online</field>
            <field name="code">PGATE</field>
