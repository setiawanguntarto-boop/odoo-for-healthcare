<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_claims_admin" model="res.groups">
        <field name="name">Tata Kelola Klinik: Staf Klaim &amp; Kasir</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Alias for prompt consistency -->
    <record id="group_clinic_cashier" model="res.groups">
        <field name="name">Tata Kelola Klinik: Kasir Klinik</field>
        <field name="implied_ids" eval="[(4, ref('adera_core.group_claims_admin'))]"/>
    </record>

    <record id="group_pharmacy_pic" model="res.groups">
        <field name="name">Tata Kelola Klinik: Apoteker Penanggung Jawab (PJ Farmasi)</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_medical_manager" model="res.groups">
        <field name="name">Tata Kelola Klinik: Manajer Pelayanan Medis</field>
        <field name="implied_ids" eval="[(4, ref('adera_core.group_claims_admin')), (4, ref('adera_core.group_pharmacy_pic'))]"/>
    </record>

    <record id="group_clinic_director" model="res.groups">
        <field name="name">Tata Kelola Klinik: Direktur Klinik &amp; Keuangan</field>
        <field name="implied_ids" eval="[(4, ref('adera_core.group_medical_manager'))]"/>
    </record>
</odoo>
