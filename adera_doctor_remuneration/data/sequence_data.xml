<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_medical_fee_accrual" model="ir.sequence">
            <field name="name">Akrual Jasa Medis</field>
            <field name="code">medical.fee.accrual</field>
            <field name="prefix">JM/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_doctor_settlement" model="ir.sequence">
            <field name="name">Doctor Settlement Sheet</field>
            <field name="code">doctor.settlement</field>
            <field name="prefix">SETT-DOC/%(year)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>

