<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_adera" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.adera</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="manufacturer_id" placeholder="Contoh: PT Kalbe Farma / Fresenius Medical Care"/>
                <field name="distributor_license_no"/>
            </xpath>
        </field>
    </record>
</odoo>

