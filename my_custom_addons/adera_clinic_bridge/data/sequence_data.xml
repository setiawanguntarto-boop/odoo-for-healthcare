<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_clinic_encounter" model="ir.sequence">
            <field name="name">Clinic Encounter</field>
            <field name="code">clinic.encounter</field>
            <field name="prefix">ENC/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
        </record>

        <record id="default_adera_api_config" model="adera.api.config">
            <field name="name">Klinik EHR Primary API Key</field>
            <field name="api_key">adera_secret_token_2026</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

