<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="adera_core.LandingPage">
        <div class="o_adera_landing_page d-flex flex-column h-100 w-100 overflow-auto">
            <!-- Clinic Header Banner -->
            <div class="o_adera_hero_banner text-center py-4 px-3">
                <div class="o_adera_hero_badge d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2 shadow-sm">
                    <i class="fa fa-hospital-o text-primary"/>
                    <span class="fw-bold text-dark tracking-wide">KLINIK ADERA</span>
                    <span class="badge bg-primary text-white rounded-pill px-2 py-1 ms-1">ERP V19</span>
                </div>
                <h2 class="o_adera_hero_title fw-bold text-dark mt-2 mb-1">
                    Sistem Operasional &amp; Keuangan Klinik Terintegrasi
                </h2>
                <p class="o_adera_hero_subtitle text-muted mb-0">
                    Pilih modul pelayanan klinis, kasir, farmasi, atau akuntansi untuk memulai
                </p>
            </div>

            <!-- Main App Switcher Grid -->
            <div class="o_adera_grid_wrapper flex-grow-1 d-flex justify-content-center p-3 p-md-4">
                <div class="o_adera_grid">
                    <t t-foreach="apps" t-as="app" t-key="app.id">
                        <div class="o_adera_app_card text-center d-flex flex-column align-items-center"
                             t-att-data-menu-id="app.id"
                             t-att-title="app.name"
                             t-on-click="() => this.onAppClick(app)">
                            <div class="o_adera_app_icon_wrapper d-flex align-items-center justify-content-center">
                                <t t-if="app.iconSrc">
                                    <img class="o_adera_app_icon" t-att-src="app.iconSrc" t-att-alt="app.name"/>
                                </t>
                                <t t-else="">
                                    <div class="o_adera_fallback_icon d-flex align-items-center justify-content-center">
                                        <i class="fa fa-cubes fs-2 text-primary"/>
                                    </div>
                                </t>
                            </div>
                            <span class="o_adera_app_name mt-2 text-truncate" t-esc="app.name"/>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Footer Info -->
            <div class="o_adera_footer text-center py-3 text-muted small">
                <span>Decoupled Healthcare ERP • Odoo 19 Community Edition • PT Prosperra Medika Utama</span>
            </div>
        </div>
    </t>

</templates>
