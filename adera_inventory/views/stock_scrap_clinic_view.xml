<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_scrap_clinic_form" model="ir.ui.view">
        <field name="name">stock.scrap.clinic.form</field>
        <field name="model">stock.scrap.clinic</field>
        <field name="arch" type="xml">
            <form string="Pemusnahan Sisa Obat Multidosis Terbuka (Open-Vial Spoilage)">
                <sheet>
                    <div class="oe_title">
                        <h2>Pemusnahan Sisa Obat Terbuka (Spoilage / Waste)</h2>
                        <p class="text-muted">
                            Penghapusan sisa dosis vaksin / ampul multidosis yang telah melewati batas stabilitas in-use (&gt;24 jam pasca buka).
                        </p>
                    </div>

                    <div class="alert alert-warning d-flex align-items-center mb-3" role="alert" invisible="not requires_medical_manager">
                        <i class="fa fa-exclamation-triangle fs-4 me-2" title="Peringatan Nilai Tinggi"/>
                        <div>
                            <strong>Peringatan Nilai Tinggi:</strong> Estimasi kerugian obat melebihi <strong>Rp 500.000</strong>. Pemusnahan ini memerlukan otorisasi dari <strong>Manajer Pelayanan Medis / Direktur</strong>.
                        </div>
                    </div>

                    <group>
                        <group string="Identifikasi Sediaan &amp; Lot Farmasi">
                            <field name="lot_id" options="{'no_create': True}"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="requires_medical_manager" invisible="1"/>
                        </group>
                        <group string="Kapasitas Dosis &amp; Kuantitas Pemusnahan">
                            <field name="opened_datetime"/>
                            <field name="dose_capacity" readonly="1"/>
                            <field name="doses_remaining" readonly="1"/>
                            <field name="discarded_doses" string="Dosis Terbuang / Dimusnahkan"/>
                            <field name="vial_unit_quantity" readonly="1"/>
                            <field name="spoilage_reason"/>
                        </group>
                    </group>

                    <group string="Otorisasi &amp; Pemisahan Tugas (SoD)">
                        <group>
                            <field name="pharmacist_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="approver_id" readonly="1" invisible="not approver_id"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>

                    <group string="Pemetaan Akuntansi &amp; Unit Bisnis Klinis">
                        <group>
                            <field name="analytic_account_id" options="{'no_create': True}"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="spoilage_account_id" options="{'no_create': True}"/>
                            <field name="inventory_account_id" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group string="Penilaian Finansial &amp; Kerugian Spoilage">
                        <group>
                            <field name="unit_cost" widget="monetary" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_spoilage_cost" widget="monetary" readonly="1" class="text-danger fw-bold fs-5"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_scrap"
                            string="Setujui &amp; Bukukan Pemusnahan (510010)"
                            type="object"
                            class="btn-danger"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_scrap_clinic" model="ir.actions.act_window">
        <field name="name">Pemusnahan Sisa Vial Terbuka (Open-Vial Spoilage)</field>
        <field name="res_model">stock.scrap.clinic</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item under Inventory Operations -->
    <menuitem id="menu_stock_scrap_clinic"
              name="Pemusnahan Obat Terbuka (Spoilage)"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_stock_scrap_clinic"
              sequence="55"/>
</odoo>
