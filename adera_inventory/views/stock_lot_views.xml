<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_form_inherit_adera" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.adera</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_vial"
                            string="Buka Segel / Tusuk Vial (24 Jam)"
                            type="object"
                            class="btn-primary"
                            invisible="is_opened or not is_multi_dose"/>
                    <button name="action_open_spoilage_wizard"
                            string="Catat Sisa Dosis Terbuang (Scrap Open-Vial)"
                            type="object"
                            class="btn-outline-danger"
                            invisible="not is_opened"/>
                    <button name="action_quarantine_batch"
                            string="Karantina / Batch Recall"
                            type="object"
                            class="btn-danger"
                            confirm="PERINGATAN: Apakah Anda yakin ingin mengkarantina nomor batch ini? Seluruh stok fisik akan dipindahkan ke Gudang Karantina dan sistem akan memblokir obat ini dari resep dokter dan kasir POS."
                            invisible="is_quarantined"/>
                    <button name="action_release_quarantine"
                            string="Cabut Karantina"
                            type="object"
                            class="btn-secondary"
                            confirm="Apakah Anda yakin hasil audit/investigasi menyatakan nomor batch ini aman untuk diedarkan kembali?"
                            invisible="not is_quarantined"/>
                </header>
                <div class="alert alert-danger text-center fw-bold mb-0 py-2" role="alert" invisible="not is_quarantined">
                    ⚠️ NOMOR BATCH / LOT INI SEDANG DALAM STATUS KARANTINA ATAU PENARIKAN (BATCH RECALL). DILARANG KERAS DIKELUARKAN KE PASIEN!
                </div>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="expiry_status" widget="badge"
                       decoration-success="expiry_status == 'valid'"
                       decoration-warning="expiry_status == 'near_expiry'"
                       decoration-danger="expiry_status in ('critical', 'expired')"/>
                <field name="days_to_expire"/>
                <field name="is_quarantined" widget="boolean_toggle"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Audit Karantina &amp; Batch Recall BPOM" invisible="not is_quarantined and not quarantine_reason">
                    <group>
                        <field name="quarantine_reason" readonly="is_quarantined"/>
                        <field name="quarantined_by_id"/>
                        <field name="quarantined_datetime"/>
                    </group>
                    <group>
                        <field name="quarantine_notes" placeholder="Tuliskan nomor surat edaran BPOM / evaluasi keselamatan pasien..." readonly="is_quarantined"/>
                    </group>
                </group>
                <group string="Manajemen Vial Multidosis &amp; Batas Viabilitas Pasca Buka (Open-Vial FEFO)">
                    <group>
                        <field name="is_multi_dose"/>
                        <field name="dose_capacity" invisible="not is_multi_dose"/>
                        <field name="doses_administered" invisible="not is_multi_dose"/>
                        <field name="doses_remaining" invisible="not is_multi_dose"/>
                    </group>
                    <group>
                        <field name="is_opened" widget="boolean_toggle"/>
                        <field name="opened_date" invisible="not is_opened"/>
                        <field name="viability_hours" invisible="not is_multi_dose"/>
                        <field name="open_expiration_date" invisible="not is_opened"/>
                        <field name="is_open_vial_expired" widget="badge"
                               decoration-danger="is_open_vial_expired"
                               decoration-success="not is_open_vial_expired and is_opened"
                               invisible="not is_opened"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_tree_inherit_adera" model="ir.ui.view">
        <field name="name">stock.lot.tree.inherit.adera</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_date']" position="after">
                <field name="expiration_date"/>
                <field name="days_to_expire"/>
                <field name="expiry_status" widget="badge"
                       decoration-success="expiry_status == 'valid'"
                       decoration-warning="expiry_status == 'near_expiry'"
                       decoration-danger="expiry_status in ('critical', 'expired')"/>
                <field name="is_opened" widget="badge" decoration-warning="is_opened"/>
                <field name="doses_remaining" optional="show"/>
                <field name="is_open_vial_expired" widget="badge" decoration-danger="is_open_vial_expired" optional="show"/>
                <field name="is_quarantined" widget="badge" decoration-danger="is_quarantined"/>
                <field name="quarantine_reason" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
