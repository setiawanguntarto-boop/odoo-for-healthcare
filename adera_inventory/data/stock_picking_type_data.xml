<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Penerimaan PBF (GRN - Goods Receipts) -->
        <record id="stock_picking_type_grn_pbf" model="stock.picking.type">
            <field name="name">Penerimaan Barang PBF (GRN)</field>
            <field name="code">incoming</field>
            <field name="sequence_code">GRN-PBF</field>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="default_location_src_id" ref="stock.stock_location_suppliers"/>
            <field name="default_location_dest_id" ref="stock.stock_location_stock"/>
            <field name="use_create_lots">true</field>
            <field name="use_existing_lots">false</field>
            <field name="show_operations">true</field>
        </record>

        <!-- 2. Dispensing Resep & Pasien (Outpatient Dispensing) -->
        <record id="stock_picking_type_outpatient_dispensing" model="stock.picking.type">
            <field name="name">Dispensing Resep &amp; Pasien Rawat Jalan</field>
            <field name="code">outgoing</field>
            <field name="sequence_code">DISP</field>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="default_location_src_id" ref="adera_inventory.stock_location_farmasi"/>
            <field name="default_location_dest_id" ref="stock.stock_location_customers"/>
            <field name="use_create_lots">false</field>
            <field name="use_existing_lots">true</field>
            <field name="show_operations">true</field>
        </record>

        <!-- 3. Konsumsi Tindakan Hemodialisis (HD Procedure Consumables) -->
        <record id="stock_picking_type_hd_consumption" model="stock.picking.type">
            <field name="name">Konsumsi Tindakan Hemodialisis</field>
            <field name="code">outgoing</field>
            <field name="sequence_code">HD-CONS</field>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="default_location_src_id" ref="adera_inventory.stock_location_hd"/>
            <field name="default_location_dest_id" ref="adera_inventory.stock_location_hd_consumption"/>
            <field name="use_create_lots">false</field>
            <field name="use_existing_lots">true</field>
            <field name="show_operations">true</field>
        </record>

        <!-- 4. Mutasi Antar Depo (Internal Transfers) -->
        <record id="stock_picking_type_depo_transfer" model="stock.picking.type">
            <field name="name">Mutasi Antar Depo</field>
            <field name="code">internal</field>
            <field name="sequence_code">DEP-TRF</field>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="default_location_src_id" ref="stock.stock_location_stock"/>
            <field name="default_location_dest_id" ref="adera_inventory.stock_location_farmasi"/>
            <field name="use_create_lots">false</field>
            <field name="use_existing_lots">true</field>
            <field name="show_operations">true</field>
        </record>
    </data>
</odoo>

